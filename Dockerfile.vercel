# ClinicFlow single-container deployment for Vercel Hobby.
# The API and approved UI run as one HTTP service, avoiding Vercel's
# serverless-function discovery of the files under api/.
FROM node:22-alpine AS build
WORKDIR /app
COPY api/package.json ./api/package.json
RUN npm install --prefix api
COPY api ./api
RUN npm run build --prefix api

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/api/node_modules ./api/node_modules
COPY --from=build /app/api/dist ./api/dist
COPY index.html styles.css mock-data.js ./
ENV NODE_ENV=production
CMD ["node", "api/dist/index.js"]
