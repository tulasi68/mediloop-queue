# ClinicFlow single-container deployment for Vercel Hobby.
# Uses `server/` (not `api/`) so Vercel does not treat source files
# as individual serverless functions (Hobby limit: 12).
FROM node:22-alpine AS build
WORKDIR /app
COPY server/package.json ./server/package.json
RUN npm install --prefix server
COPY server ./server
RUN npm run build --prefix server

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/server/node_modules ./server/node_modules
COPY --from=build /app/server/dist ./server/dist
COPY index.html styles.css mock-data.js ./
ENV NODE_ENV=production
ENV STATIC_ROOT=/app
EXPOSE 3001
CMD ["node", "server/dist/index.js"]
